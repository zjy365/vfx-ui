{
  "name": "vfx-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Expressive React components, shaders, headers, heroes and footers. Free open source library and complete Pro templates.",
  "license": "MIT",
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:docs": "pnpm --filter @vfx-ui/docs dev",
    "dev:playground": "pnpm --filter @vfx-ui/playground dev",
    "catalog:check": "node scripts/check-catalog.mjs",
    "test:consumer": "node scripts/check-package-consumers.mjs",
    "dev:legacy": "pnpm --filter @vfx-ui/legacy-docs dev"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.3"
  }
}
