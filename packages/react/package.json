{
  "name": "@vfx-ui/react",
  "version": "0.1.1",
  "description": "Expressive React components: shaders, heroes, footers, page blocks and DOM interactions.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./canvas": {
      "types": "./dist/VfxCanvas.d.ts",
      "import": "./dist/VfxCanvas.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@vfx-ui/core": "workspace:*",
    "cobe": "^2.0.1",
    "vgpu": "0.3.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@webgpu/types": "^0.1.74",
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjy365/vfx-ui.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/zjy365/vfx-ui/issues"
  },
  "homepage": "https://vfx-ui.com",
  "keywords": [
    "react",
    "webgpu",
    "shader",
    "wgsl",
    "vgpu",
    "visual-effects",
    "hero-section",
    "gpu",
    "animation"
  ],
  "module": "./dist/index.js",
  "sideEffects": false
}
