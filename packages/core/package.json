{
  "name": "@vfx-ui/core",
  "version": "0.1.1",
  "description": "Renderer core for vfx-ui: vgpu-backed WebGPU effect renderer with deterministic test support.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "vgpu": "0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@webgpu/types": "^0.1.69",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjy365/vfx-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/zjy365/vfx-ui/issues"
  },
  "homepage": "https://vfx-ui.com",
  "keywords": [
    "webgpu",
    "shader",
    "wgsl",
    "vgpu",
    "renderer",
    "gpu"
  ],
  "module": "./dist/index.js",
  "sideEffects": false
}
